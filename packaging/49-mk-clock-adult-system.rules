// Narrow privileges for the dedicated mk-clock-adult API account.
// Timezone changes go through systemd-timedated. Hostname and NTP settings are applied only by the fixed
// mk-clock-system-config.service helper.
polkit.addRule(function(action, subject) {
    if (subject.user != "mk-piclock-api")
        return;

    if (action.id == "org.freedesktop.timedate1.set-timezone")
        return polkit.Result.YES;

    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "mk-clock-system-config.service" &&
        action.lookup("verb") == "start")
        return polkit.Result.YES;
});
