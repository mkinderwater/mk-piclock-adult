[Unit]
Description=mk-clock-adult hardware and alarm core
Requires=mk-piclock-spidev.service
After=network.target sound.target mk-piclock-spidev.service

[Service]
Type=simple
User=mk-piclock-core
Group=mk-piclock
SupplementaryGroups=audio spi gpio i2c
Environment=MK_PICLOCK_API_USER=mk-piclock-api
# Preserve local MP3/alarm fidelity by opening the physical PCM at the decoded
# native sample rate. plughw is used only if format conversion is required.
Environment=MK_PICLOCK_ALSA_DIRECT_DEVICE=hw:MAX98357A,0
Environment=MK_PICLOCK_ALSA_DEVICE=plughw:MAX98357A,0
Environment=MK_AHT10_ENABLED=1
Environment=MK_AHT10_DEVICE=/dev/i2c-0
Environment=MK_AHT10_ADDRESS=0x38
Environment=MK_AHT10_POLL_SECONDS=10
Environment=MK_AHT10_STALE_SECONDS=120
ExecStart=/opt/mk-piclock/mk-piclock-core
WorkingDirectory=/opt/mk-piclock
Restart=always
RestartSec=3
# Process-level supervision complements the image's hardware watchdog. The core
# sends WATCHDOG=1 from its main loop, so a stalled main loop is restarted.
WatchdogSec=45s
NotifyAccess=main
UMask=0027
LimitRTPRIO=10
RuntimeDirectory=mk-piclock
RuntimeDirectoryMode=0770

NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelLogs=true
ProtectClock=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET
ReadWritePaths=/opt/mk-piclock/config /run/mk-piclock

# The core owns the BPI-M2 Zero OLED, GPIO touch input, AHT10, audio and persistent clock state.
# Its private SOCK_SEQPACKET socket is /run/mk-piclock/core.sock.

[Install]
WantedBy=multi-user.target
